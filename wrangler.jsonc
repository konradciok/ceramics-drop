{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ceramics-drop",
  "workers_dev": false,
  "main": "./worker.ts",
  "build": {
    "command": "npm run build:opennext"
  },
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Storefront catalogue source: 'db' reads shadow tables (Stage 3b flip). Rollback → remove or set 'code'.
  "vars": {
    "CATALOG_SOURCE": "db"
  },
  // Expire abandoned checkout orders (cancel open PI, free reserved pieces) every 15 minutes.
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ceramics-drop"
    }
  ],
  "routes": [
    {
      "pattern": "anna-ciok.studio",
      "custom_domain": true
    },
    {
      "pattern": "www.anna-ciok.studio",
      "custom_domain": true
    }
  ],
  "queues": {
    "producers": [
      { "binding": "FULFILMENT_QUEUE", "queue": "prodigi-fulfilment" },
      // Priority 8 / Phase 2 (Task 10) — durable job queue for print-asset
      // processing. Mirrors FULFILMENT_QUEUE's shape exactly; see worker.ts's
      // queue() handler and src/server/asset-jobs/{enqueue,process-job}.ts.
      { "binding": "ASSET_JOBS_QUEUE", "queue": "print-asset-jobs" }
    ],
    "consumers": [{
      "queue": "prodigi-fulfilment",
      "max_batch_size": 1,
      "max_retries": 10,
      "dead_letter_queue": "prodigi-fulfilment-dlq"
    }, {
      // Alert-only: the worker's queue() handler acks every DLQ message after
      // logging + Sentry + studio email. max_retries is a bounded safety net so
      // a handler bug cannot unbounded-retry; the no-loop guarantee comes from
      // ackAll in the handler (the normal path never retries).
      "queue": "prodigi-fulfilment-dlq",
      "max_retries": 1
    }, {
      "queue": "print-asset-jobs",
      "max_batch_size": 1,
      "max_retries": 10,
      "dead_letter_queue": "print-asset-jobs-dlq"
    }, {
      // Same alert-only posture as prodigi-fulfilment-dlq above.
      "queue": "print-asset-jobs-dlq",
      "max_retries": 1
    }]
  },
  "r2_buckets": [
    { "binding": "PRINT_ASSETS", "bucket_name": "anna-ciok-print-assets" }
  ],
  // Priority 8 / Phase 3 (Task 11) — the Node/Sharp derivative processor.
  // Master plan (cms-ceramics/docs/plans/2026-09-09-cms-v1.md §S3): "Początkowo
  // jedna instancja `standard-3`, jedno zadanie naraz, profile przetwarzane
  // kolejno; kontener usypiany po bezczynności. Ten typ oferuje 8 GiB pamięci."
  //   - standard-3 = 2 vCPU / 8 GiB / 16 GB disk
  //     (https://developers.cloudflare.com/containers/platform/limits/)
  //   - max_instances 1 = "one instance"; the queue consumer + the DO's own
  //     serialisation give "one job at a time".
  //   - idle sleep is set in code, not here: container.ts calls
  //     ctx.container.setInactivityTimeout(10m).
  //   - image_build_context is the REPO ROOT because the image runs this
  //     repo's own src/lib + src/server sources (see container/Dockerfile).
  //
  // ⚠️ A Container is backed by a Durable Object, so this needs BOTH the
  // durable_objects binding below AND a `migrations` entry with
  // new_sqlite_classes (NOT new_classes) — this Worker's first ever DO
  // migration. The three OpenNext DO classes worker.ts re-exports have never
  // been bound or migrated (this repo uses only the incremental cache), so
  // tag v1 registers exactly one class.
  //
  // ⚠️ `name` is DELIBERATELY OMITTED here and in env.preview. A container
  // APPLICATION is account-scoped by name — not per-Worker — and wrangler's
  // deploy path looks an existing application up BY NAME and throws a UserError
  // when it finds one bound to a different Durable Object namespace. Hardcoding
  // the same `name` in both environments would therefore hard-fail whichever of
  // the two deploys second — precisely the "deploy to preview first" sequence
  // this change recommends. Omitting it lets wrangler derive
  // `${workerName}-${class_name}`, which already differs per environment
  // (`ceramics-drop-preview` vs `ceramics-drop`). Do not "tidy" a `name` back in
  // unless you give each environment its own distinct one.
  "containers": [
    {
      "class_name": "PrintAssetProcessor",
      "image": "./container/Dockerfile",
      "image_build_context": ".",
      "instance_type": "standard-3",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PRINT_ASSET_PROCESSOR", "class_name": "PrintAssetProcessor" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PrintAssetProcessor"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 0.25
    }
  },
  // Rehearsal/preview environment (backend-audit Plan 05): workers.dev deploy with
  // DEDICATED queues so the real queue runtime can be exercised without touching
  // production traffic. Set CLOUDFLARE_ENV=preview in the process, run the guarded
  // `npm run build:opennext`, then `opennextjs-cloudflare deploy -- --env=preview`.
  // Secrets are set per-env (test/sandbox only).
  "env": {
    "preview": {
      "name": "ceramics-drop-preview",
      "workers_dev": true,
      // CRITICAL: block inheritance of the top-level custom domains — without
      // this, deploying the preview REASSIGNS anna-ciok.studio away from the
      // production worker (verified the hard way during the Plan 05 rehearsal).
      "routes": [],
      "vars": {
        "CATALOG_SOURCE": "db",
        "PRODIGI_ENV": "sandbox",
        // Drives GET /v1/session's `environment` field for the CMS API
        // (src/server/cms-api/handlers/session.ts) — anything else reports "production".
        "CMS_API_ENVIRONMENT": "integration"
      },
      "triggers": { "crons": ["*/15 * * * *"] },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "ceramics-drop-preview"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "FULFILMENT_QUEUE", "queue": "prodigi-fulfilment-preview" },
          { "binding": "ASSET_JOBS_QUEUE", "queue": "print-asset-jobs-preview" }
        ],
        "consumers": [{
          "queue": "prodigi-fulfilment-preview",
          "max_batch_size": 1,
          // 3 (prod: 10) so the failure-injection drill reaches the DLQ in minutes,
          // not hours — still exercises the same backoff → DLQ path.
          "max_retries": 3,
          "dead_letter_queue": "prodigi-fulfilment-preview-dlq"
        }, {
          "queue": "prodigi-fulfilment-preview-dlq",
          "max_retries": 1
        }, {
          "queue": "print-asset-jobs-preview",
          "max_batch_size": 1,
          "max_retries": 3,
          "dead_letter_queue": "print-asset-jobs-preview-dlq"
        }, {
          "queue": "print-asset-jobs-preview-dlq",
          "max_retries": 1
        }]
      },
      "r2_buckets": [
        { "binding": "PRINT_ASSETS", "bucket_name": "anna-ciok-print-assets" }
      ],
      // `containers` and `durable_objects` are NON-inheritable keys — an env
      // that omits them gets nothing, so they are repeated here rather than
      // inherited from the top level. (`migrations` IS inheritable and is
      // deliberately declared only once, at the top level.) Same class name:
      // the preview Worker gets its own separate container application and its
      // own separate DO namespace because it is a different Worker script
      // (`ceramics-drop-preview`) — but ONLY because no explicit `name` is set
      // here. See the top-level block's warning: a hardcoded, shared container
      // application name would make these two environments collide at deploy.
      "containers": [
        {
          "class_name": "PrintAssetProcessor",
          "image": "./container/Dockerfile",
          "image_build_context": ".",
          "instance_type": "standard-3",
          "max_instances": 1
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "PRINT_ASSET_PROCESSOR", "class_name": "PrintAssetProcessor" }
        ]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
          "invocation_logs": true
        }
      }
    }
  }
}
