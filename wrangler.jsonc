{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ceramics-drop",
  "workers_dev": false,
  "main": "./worker.ts",
  "build": {
    "command": "npm run build:opennext"
  },
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Storefront catalogue source: 'db' reads shadow tables (Stage 3b flip). Rollback → remove or set 'code'.
  "vars": {
    "CATALOG_SOURCE": "db",
    // Resend Segment ("news") that marketing broadcasts go to: confirmed newsletter
    // subscribers + buyers who ticked the checkout marketing consent.
    "RESEND_MARKETING_SEGMENT_ID": "7e74e5cb-d482-4275-9d64-ceefdbfd8734",
    // Sendcloud sender address in mainland Spain (29640 Fuengirola) — not a
    // secret; Sendcloud shipments are announced from it.
    "SENDCLOUD_SENDER_ADDRESS_ID": "962493"
  },
  // Expire abandoned checkout orders (cancel open PI, free reserved pieces) every 15 minutes.
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ceramics-drop"
    }
  ],
  "routes": [
    {
      "pattern": "anna-ciok.studio",
      "custom_domain": true
    },
    {
      "pattern": "www.anna-ciok.studio",
      "custom_domain": true
    }
  ],
  // Site media (CMS/admin uploads under `site-media/`, served by /api/media).
  // The bucket name predates the print shop's retirement; its `prints/`
  // prefix is legacy data only.
  "r2_buckets": [
    { "binding": "PRINT_ASSETS", "bucket_name": "anna-ciok-print-assets" }
  ],
  // PrintAssetProcessor was the print-asset container's Durable Object (v1).
  // The container is gone, so v2 deletes the class (and its storage) — a
  // removed DO class without a deleted_classes migration fails the deploy.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PrintAssetProcessor"] },
    { "tag": "v2", "deleted_classes": ["PrintAssetProcessor"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 0.25
    }
  },
  // Rehearsal/preview environment (backend-audit Plan 05): workers.dev deploy with
  // its own bindings so the runtime can be exercised without touching production
  // traffic. Set CLOUDFLARE_ENV=preview in the process, run the guarded
  // `npm run build:opennext`, then `opennextjs-cloudflare deploy -- --env=preview`.
  // Secrets are set per-env (test/sandbox only).
  "env": {
    "preview": {
      "name": "ceramics-drop-preview",
      "workers_dev": true,
      // CRITICAL: block inheritance of the top-level custom domains — without
      // this, deploying the preview REASSIGNS anna-ciok.studio away from the
      // production worker (verified the hard way during the Plan 05 rehearsal).
      "routes": [],
      "vars": {
        "CATALOG_SOURCE": "db",
        // Drives GET /v1/session's `environment` field for the CMS API
        // (src/server/cms-api/handlers/session.ts) — anything else reports "production".
        "CMS_API_ENVIRONMENT": "integration"
      },
      // Cron disabled (2026-10-11): the preview's Supabase project
      // (ceramics-cms-integration) is paused, so every */15 sweep failed with
      // 530 / error 1016 — ~4,000 error log lines a week and no value. An
      // empty list removes the schedule on deploy. Restore "*/15 * * * *"
      // together with resuming that project for a cron rehearsal.
      "triggers": { "crons": [] },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "ceramics-drop-preview"
        }
      ],
      "r2_buckets": [
        { "binding": "PRINT_ASSETS", "bucket_name": "anna-ciok-print-assets" }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
          "invocation_logs": true
        }
      }
    }
  }
}
