# Required for production builds on Cloudflare Workers (Workers Builds env vars).
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Sentry — error monitoring + tracing (https://docs.sentry.io/platforms/javascript/guides/nextjs/)
# Create project "ceramics-drop" (platform: Next.js) in org y9608071l-anna-ciok, then copy the DSN.
# Client DSN is inlined at build time; set as a Workers Build env var in production.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only DSN (defaults to NEXT_PUBLIC_SENTRY_DSN). For Cloudflare: wrangler secret put SENTRY_DSN
SENTRY_DSN=
# Source map uploads during `next build` / OpenNext build (CI or local). Create at sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# InPost ShipX — sole delivery provider. Generated in Manager Paczek
# (manager.paczkomaty.pl → Moje Konto → API ShipX / Geowidget / Ustawienia organizacji).
#
# Server secrets — set with `wrangler secret put <NAME>` in prod, or .dev.vars locally:
#   wrangler secret put INPOST_API_TOKEN / INPOST_ORGANIZATION_ID / INPOST_WEBHOOK_TOKEN
#   wrangler secret put RESEND_API_KEY / STUDIO_NOTIFY_EMAIL
# INPOST_API_URL may be a plain var (sandbox vs production base URL).
INPOST_API_URL=https://sandbox-api-shipx-pl.easypack24.net
INPOST_API_TOKEN=
INPOST_ORGANIZATION_ID=
# INPOST_WEBHOOK_TOKEN guards the inbound status callback. InPost only lets you
# register a URL (no custom headers), so it rides in the query string:
#   https://anna-ciok.studio/api/inpost/webhook?token=<INPOST_WEBHOOK_TOKEN>
# Use a high-entropy value, rotate if access logs are broadly retained, and avoid
# logging full request URLs in production.
INPOST_WEBHOOK_TOKEN=
RESEND_API_KEY=
STUDIO_NOTIFY_EMAIL=studio@ciok.art
# Svix signing secret for the Resend webhook (delivery/bounce/complaint), which
# posts to https://anna-ciok.studio/api/resend/webhook. Copy from the Resend
# dashboard when you create the webhook endpoint, then:
#   wrangler secret put RESEND_WEBHOOK_SECRET
RESEND_WEBHOOK_SECRET=
# Resend templates (published in dashboard; aliases wired in src/lib/email-layout.ts):
#   label-to-studio · shipping-confirmation · return-label-customer
# All Resend transactional mail sends FROM sklep@ciok.art (domain ciok.art verified; no OVH mailbox needed).
# Label PDFs arrive at STUDIO_NOTIFY_EMAIL (studio@ciok.art OVH mailbox); subject prefix [Etykieta] for inbox filters.
# Studio return address — used as the InPost shipment receiver for customer returns.
# All fields must be set to enable POST /api/returns; the endpoint returns 503 otherwise.
#   wrangler secret put STUDIO_RETURN_FIRST_NAME / STUDIO_RETURN_LAST_NAME / STUDIO_RETURN_PHONE
#   wrangler secret put STUDIO_RETURN_ADDRESS_STREET / _BUILDING / _CITY / _POSTAL
# Optional: STUDIO_RETURN_EMAIL defaults to STUDIO_NOTIFY_EMAIL when unset.
# Required for POST /api/returns: paczkomat code customers use for return drop-off (e.g. WAW20A).
STUDIO_RETURN_FIRST_NAME=
STUDIO_RETURN_LAST_NAME=
STUDIO_RETURN_EMAIL=
STUDIO_RETURN_PHONE=
STUDIO_RETURN_ADDRESS_STREET=
STUDIO_RETURN_ADDRESS_BUILDING=
STUDIO_RETURN_ADDRESS_CITY=
STUDIO_RETURN_ADDRESS_POSTAL=
STUDIO_RETURN_POINT=
# Public (browser) — Geowidget locker picker. These are inlined into the client
# bundle at BUILD time, so set them as Workers Build env vars, NOT wrangler secrets.
# Generate in Manager Paczek → Geowidget; never commit a real token here.
NEXT_PUBLIC_INPOST_GEOWIDGET_TOKEN=
NEXT_PUBLIC_INPOST_GEOWIDGET_ENV=sandbox

# Server-side conversions (Meta Conversions API + GA4 Measurement Protocol)
# Server secrets — set with `wrangler secret put <NAME>` in prod, or .dev.vars locally:
#   wrangler secret put META_CAPI_ACCESS_TOKEN / GA4_API_SECRET
META_CAPI_ACCESS_TOKEN=        # Meta system-user token with ads_management/CAPI scope
META_TEST_EVENT_CODE=          # optional: Events Manager → Test Events code (leave empty in prod)
GA4_API_SECRET=                # GA4 Admin → Data Streams → Measurement Protocol API secrets

# Stripe Payments — payment processing via Payment Element. Obtain keys from
# the Stripe Dashboard (https://dashboard.stripe.com/apikeys). Test and live
# modes use different keys; the secret key, publishable key, and webhook secret
# must all be from the same mode.
#
# Server secrets — set with `wrangler secret put <NAME>` in prod, or .dev.vars locally:
#   wrangler secret put STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public (browser) — used in the Payment Element. Inlined into the client bundle
# at BUILD time, so set it as a Workers Build env var, NOT a wrangler secret.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Supabase — database and realtime via Supabase (https://supabase.com). Obtain
# these from the Project Settings → API and Database credentials in the Supabase Dashboard.
#
# Server secrets — set with `wrangler secret put <NAME>` in prod, or .dev.vars locally:
#   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Access — admin route auth (worker.ts guard; see src/lib/admin/access.ts).
# Create a self-hosted Access application for anna-ciok.studio/admin* and /api/admin*
# in the Cloudflare Zero Trust dashboard, then copy the values below.
# Server secrets — set with `wrangler secret put <NAME>` in prod, or .dev.vars locally:
#   wrangler secret put CF_ACCESS_TEAM_DOMAIN CF_ACCESS_AUD
# CF_ACCESS_TEAM_DOMAIN: full issuer origin, e.g. https://<team>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD: Application Audience tag from Zero Trust → Access → <application> → Overview.
CF_ACCESS_AUD=
# Optional comma-separated email allowlist (defense in depth, mirrors the Access policy).
#   wrangler secret put ADMIN_ALLOWED_EMAILS
ADMIN_ALLOWED_EMAILS=
# LOCAL DEV ONLY — set to "true" to skip JWT verification on localhost / LAN.
# ⚠️  NEVER set this in production or on a public-facing host — it disables all auth.
STUDIO_ADMIN_LOCAL_BYPASS=

# OVHcloud API — MCP / local tooling (Cursor ovhcloud MCP server).
# Create keys: https://eu.api.ovh.com/createToken/?GET=/*&POST=/*&PUT=/*&DELETE=/*
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_ENDPOINT=ovh-eu

GCP_PROJECT_ID=bloomy-tale-477216
GTM_SERVICE_ACCOUNT_EMAIL=gtm-api-deploy@bloomy-tale-477216.iam.gserviceaccount.com
GTM_ACCOUNT_ID=000000000
GTM_CONTAINER_ID=000000000
GTM_WORKSPACE_NAME=ACC analytics stack

# Notion — edit messages/pl.json in a Notion table (scripts/notion-i18n/).
# Create integration: https://www.notion.so/my-integrations
# Share the translations database (or parent page) with the integration.
NOTION_TOKEN=
# Database ID from setup or an existing "ACC — Polish translations" DB URL.
NOTION_DATABASE_ID=
# Only for npm run i18n:setup (one-time database creation under a parent page).
NOTION_PARENT_PAGE_ID=

# Product note generation — vision-based Polish descriptions for messages/pl.json.
# Used by: npm run notes:generate -- --category kubki [--category talerze-srednie]
# The key is already present in .env.local in this repo — no need to create a new one.
OPENAI_API_KEY=
# Optional override for the vision model used by scripts/generate-product-notes.mjs.
OPENAI_MODEL=

# Prodigi Print-on-Demand
# Prodigi dashboard → API keys → sandbox
PRODIGI_API_KEY_SANDBOX=
# Prodigi dashboard → API keys → live
PRODIGI_API_KEY_LIVE=
# set to "live" only after cutover checklist
PRODIGI_ENV=sandbox
# openssl rand -hex 32
PRODIGI_CALLBACK_TOKEN=
# openssl rand -hex 32
PRINT_ASSET_TOKEN_SECRET=
PRODIGI_DEFAULT_SHIPPING_METHOD=Budget
