# Required for production builds on Cloudflare Workers (Workers Builds env vars).
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# InPost ShipX — sole delivery provider. Generated in Manager Paczek
# (manager.paczkomaty.pl → Moje Konto → API ShipX / Geowidget / Ustawienia organizacji).
#
# Server secrets — set with `wrangler secret put <NAME>` in prod, or .dev.vars locally:
#   wrangler secret put INPOST_API_TOKEN / INPOST_ORGANIZATION_ID / INPOST_WEBHOOK_TOKEN
#   wrangler secret put RESEND_API_KEY / STUDIO_NOTIFY_EMAIL
# INPOST_API_URL may be a plain var (sandbox vs production base URL).
INPOST_API_URL=https://sandbox-api-shipx-pl.easypack24.net
INPOST_API_TOKEN=
INPOST_ORGANIZATION_ID=
# INPOST_WEBHOOK_TOKEN guards the inbound status callback. InPost only lets you
# register a URL (no custom headers), so it rides in the query string:
#   https://anna-ciok.studio/api/inpost/webhook?token=<INPOST_WEBHOOK_TOKEN>
# Use a high-entropy value, rotate if access logs are broadly retained, and avoid
# logging full request URLs in production.
INPOST_WEBHOOK_TOKEN=
RESEND_API_KEY=
STUDIO_NOTIFY_EMAIL=studio@example.com
# Public (browser) — Geowidget locker picker. These are inlined into the client
# bundle at BUILD time, so set them as Workers Build env vars, NOT wrangler secrets.
NEXT_PUBLIC_INPOST_GEOWIDGET_TOKEN=
NEXT_PUBLIC_INPOST_GEOWIDGET_ENV=sandbox

GCP_PROJECT_ID=bloomy-tale-477216
GTM_SERVICE_ACCOUNT_EMAIL=gtm-api-deploy@bloomy-tale-477216.iam.gserviceaccount.com
GTM_ACCOUNT_ID=000000000
GTM_CONTAINER_ID=000000000
GTM_WORKSPACE_NAME=ACC analytics stack
