{
  "name": "ceramics-drop",
  "version": "0.8.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "description": "Anna Ciok Ceramics — storefront (Next.js)",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test --grep @ci",
    "test:e2e:edge": "playwright test --grep @checkout-edge",
    "gtm:key": "node -e \"require('node:fs').mkdirSync('.secrets',{recursive:true})\" && gcloud iam service-accounts keys create .secrets/gtm-api-deploy.json --iam-account=gtm-api-deploy@anna-ciok-studio-analytics.iam.gserviceaccount.com --project=anna-ciok-studio-analytics",
    "gtm:list": "node scripts/gtm-api.mjs list",
    "gtm:setup": "node scripts/gtm-api.mjs setup",
    "ga4:report": "node scripts/ga4-data.mjs",
    "bq:query": "node scripts/bq-query.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "notes:generate": "node scripts/generate-product-notes.mjs",
    "private-sale:create": "tsx scripts/create-private-sale-link.ts",
    "drop:create": "tsx scripts/create-drop.ts",
    "prodigi": "tsx scripts/prodigi-cli.ts",
    "prodigi:contract-smoke": "tsx scripts/prodigi-contract-smoke.ts",
    "orders": "tsx scripts/orders-cli.ts",
    "sync-prodigi-skus": "tsx scripts/sync-prodigi-skus.ts",
    "print-assets:inventory": "tsx scripts/print-asset-inventory.ts",
    "print-fulfilment:check-jobs": "tsx scripts/check-print-fulfilment-jobs.ts",
    "print-assets:prepare": "tsx scripts/print-assets-prepare.ts",
    "print-assets:upload": "tsx scripts/print-assets-upload.ts",
    "print-assets:verify": "tsx scripts/print-assets-verify.ts",
    "print-assets:publish": "tsx scripts/print-assets-publish.ts",
    "print-assets:gallery": "tsx scripts/print-assets-gallery.ts",
    "print-assets:sandbox-matrix": "tsx scripts/print-assets-sandbox-matrix.ts",
    "print-asset:smoke": "tsx scripts/print-asset-smoke.ts",
    "catalog:backfill": "tsx scripts/backfill-catalog.ts",
    "debug:meta-capi": "node scripts/debug-meta-capi.mjs",
    "generate-image-variants": "node scripts/optimize-images.mjs --variants-only",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false --include-env=true --env-file .env.cf-typegen cloudflare-env.d.ts",
    "cf:dns-cleanup": "node scripts/cloudflare-dns-cleanup.mjs",
    "cf:com-redirect": "node scripts/cloudflare-com-redirect-setup.mjs",
    "i18n:check": "node scripts/notion-i18n/check.mjs",
    "i18n:organize": "node scripts/notion-i18n/organize.mjs",
    "i18n:setup": "node scripts/notion-i18n/setup.mjs",
    "i18n:push": "node scripts/notion-i18n/push.mjs",
    "i18n:pull": "node scripts/notion-i18n/pull.mjs",
    "admin:dev:lan": "next dev --port 3010 --hostname 0.0.0.0",
    "admin:proxy": "docker compose -f local-admin/compose.yaml up -d",
    "admin:proxy:down": "docker compose -f local-admin/compose.yaml down",
    "reconcile:orders": "node scripts/reconcile-orders.mjs"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "@sentry/nextjs": "^10.56.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.7.0",
    "@supabase/supabase-js": "^2.107.0",
    "@swc/helpers": "^0.5.23",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.9",
    "next": "^16.2.7",
    "next-intl": "^4.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^22.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "googleapis": "^173.0.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.97.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "postcss": ">=8.5.10"
  }
}
